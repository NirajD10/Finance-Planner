# Local Vite dev server, API run directly on host: bun run dev (server/)
VITE_API_BASE=http://localhost:3000

# Production build (served by Caddy, same-origin) uses .env.production and
# leaves this empty — see that file.

# Android emulator build (bun run build --mode android) uses .env.android
# and points at the host's Caddy port via the emulator's 10.0.2.2 alias.
