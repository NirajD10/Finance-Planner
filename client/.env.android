# Android emulator: 10.0.2.2 is the emulator's alias for the host machine's
# loopback interface. Points at the Caddy port published by deploy/docker-compose.yml.
#
# Testing on a physical device instead of the emulator? Replace this with your
# host machine's LAN IP (e.g. http://192.168.x.x:8080) — both devices must be
# on the same network, and 10.0.2.2 will not resolve from real hardware.
VITE_API_BASE=http://10.0.2.2:8080
