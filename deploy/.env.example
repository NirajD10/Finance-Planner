# Copy to deploy/.env and fill in real values. Never commit deploy/.env.
POSTGRES_PASSWORD=changeme_local_dev_password
WEB_ORIGIN=http://localhost:8080
SITE_ADDRESS=:80

# Generate with: openssl rand -base64 48
JWT_SECRET=changeme_dev_only_jwt_secret

# argon2id hash of the single hardcoded login password. Generate with:
# docker compose run --rm api bun run scripts/hash-password.ts <password>
# Docker Compose interpolates $ in .env values — escape every literal $ in the
# hash as $$, or the hash will be silently mangled.
AUTH_PASSWORD_HASH=changeme_run_hash-password_ts
