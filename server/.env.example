# Copy to server/.env for `bun run dev` outside Docker, or to run
# db:generate/db:migrate/db:seed against the Dockerized Postgres from the host
# (deploy/docker-compose.yml publishes it on 127.0.0.1:55432, not the default
# 5432, since 5432 is often already taken by another local Postgres install).
DATABASE_URL=postgres://finance:changeme_local_dev_password@localhost:55432/finance_planner

# Origin of the web client during local dev (Vite dev server).
WEB_ORIGIN=http://localhost:5173

# Any long random string; used to sign/verify access JWTs. Never commit the
# real value. Generate one with: openssl rand -base64 48
JWT_SECRET=changeme_dev_only_jwt_secret

# argon2id hash of the single hardcoded login password — never the raw
# password. Generate with: bun run scripts/hash-password.ts <password>
# Bun's own .env loader expands $VAR syntax (like Docker Compose's, but with
# its own rule): escape every literal $ in the hash as \$, or it gets mangled.
AUTH_PASSWORD_HASH=changeme_run_scripts_hash-password_ts
